.tabs { display: flex; padding: 12px; }
.tab { flex: 1; text-align: center; padding: 8px; background: #fff; border-radius: 20px; margin: 0 4px; }
.tab.on { background: #f6ffed; color: #389e0d; }
.card { background: #fff; margin: 8px 12px; padding: 14px; border-radius: 12px; }
.name { font-weight: 600; }
.meta { font-size: 12px; color: #999; margin-top: 4px; }
.empty { text-align: center; color: #999; padding: 40px; }
